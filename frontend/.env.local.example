# Copy to frontend/.env.local and fill in. Never commit the real file.

# Required
OWNER_EMAIL=owner@example.com
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# At least 32 bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SECRET_KEY=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Optional (defaults shown)
SESSION_COOKIE_NAME=finance_session
SESSION_ABSOLUTE_DAYS=7
SESSION_IDLE_HOURS=24
LOGIN_MAX_FAILURES_PER_IP=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=20
TRUSTED_PROXY=false

# Password reset email (EMAIL_PROVIDER: disabled | smtp | brevo)
PASSWORD_RESET_ENABLED=false
EMAIL_PROVIDER=disabled
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost
