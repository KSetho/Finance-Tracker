# Copy to backend/.env and fill in. Never commit the real file.
OWNER_EMAIL=your-email@example.com
# SQLite is supported for local development and needs no separate database server.
DATABASE_URL=sqlite:///./finance.db
# PostgreSQL remains the production and full-concurrency option:
# DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5433/finance
SECRET_KEY=replace-with-python-secrets-token_urlsafe-64
SESSION_COOKIE_NAME=finance_session
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Optional tuning (defaults shown)
SESSION_ABSOLUTE_DAYS=7
SESSION_IDLE_HOURS=24
LOGIN_MAX_FAILURES_PER_IP=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=20
LOGIN_WINDOW_MINUTES=15
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=15
# disabled | smtp | brevo
EMAIL_PROVIDER=disabled
# For EMAIL_PROVIDER=brevo, SMTP_HOST/PORT/STARTTLS are selected automatically.
# Use your Brevo SMTP login and SMTP key (not the Brevo API key).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
TRUSTED_PROXY=false
